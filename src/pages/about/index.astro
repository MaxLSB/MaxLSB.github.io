---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import BaseHero from "../../components/shared/BaseHero.astro";
import ArticleCard from "../../components/ui/ArticleCard.astro";
import Container from "../../components/ui/Container.astro";
import ContentList from "../../components/shared/ContentList.astro";
---

<BaseLayout title="About Me" description="Learn more about my background and experiences">
  <Container>
    <BaseHero title="About Me" description="Learn more about my background and experiences" />
    
    <p class="intro-text">
      I'm a PhD student at LightOn and INRIA working on post-training for LLMs. I graduated from Télécom SudParis and pursued the IASD Master's program, hosted by ENS Ulm and Paris Dauphine–PSL, where I also took several shared courses from the MVA Master at ENS Paris-Saclay.
    </p>
    
    <!-- Experiences Section -->
    <section class="section">
      <h2>Experiences</h2>
      <ContentList>
        <ArticleCard
          title="PhD Student"
          description="LightOn & INRIA (CIFRE)"
          url="#"
          logo="/images/LightOn.png"
          dateRange="February 2026 - ongoing"
          clickable={false}
        />
        <ArticleCard
          title="AI Research Intern"
          description="LightOn"
          url="#"
          logo="/images/LightOn.png"
          dateRange="April 2025 - September 2025"
          clickable={false}
        />
        <ArticleCard
          title="AI Research Intern"
          description="Fondazione Bruno Kessler"
          url="#"
          logo="/images/FBK.png"
          dateRange="June 2024 - September 2024"
          clickable={false}
        />
      </ContentList>
    </section>

    <!-- Education Section -->
    <section class="section">
      <h2>Education</h2>
      <ContentList>
        <ArticleCard
          title="Master in Machine Learning"
          description="IASD - ENS-Ulm & Paris Dauphine-PSL"
          url="#"
          logo="/images/IASD.png"
          dateRange="2024 - 2025"
          clickable={false}
        />
        <ArticleCard
          title="MSc in Statistics"
          description="Télécom SudParis"
          url="#"
          logo="/images/TSP.png"
          dateRange="2021 - 2024"
          clickable={false}
        />
        <ArticleCard
          title="Preparatory Classes MPSI - MP*"
          description="Fénelon-Sainte-Marie"
          url="#"
          logo="/images/FSM.png"
          dateRange="2019 - 2021"
          clickable={false}
        />
      </ContentList>
    </section>
  </Container>
</BaseLayout>

<style>
  .intro-text {
    font-size: var(--text-lg);
    line-height: 1.75;
    color: var(--text-muted);
    margin: 1.5rem 0 3rem;
    max-width: 68ch;
  }

  .section h2 {
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
  }

  .section + .section {
    margin-top: 3rem;
  }

  @media (max-width: 640px) {
    .intro-text {
      font-size: var(--text-base);
      margin: 1.25rem 0 2rem;
    }

    .section + .section {
      margin-top: 2rem;
    }
  }
</style>
