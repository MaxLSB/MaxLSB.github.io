---
import { getEntry } from "astro:content";
import BaseLayout from "../components/layout/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import SocialIcon from "../components/SocialIcon.astro";
import ActivityGallery from "../components/ui/ActivityGallery.astro";
import { activity } from "../data/activity";

const siteConfig = await getEntry("site", "home");
if (!siteConfig) {
  throw new Error("Site configuration not found");
}
const site = siteConfig.data;
const photoRowAspectRatio = Math.max(...activity.map((item) =>
  item.photos?.reduce((sum, photo) => sum + photo.src.width / photo.src.height, 0) ?? 0
));
---

<BaseLayout
  title={site.name}
  description="Maxence Lasbordes — research on post-training and multilingual language models. Recent papers, model releases, and conferences."
>
  <Container>
    <section class="profile" aria-labelledby="profile-name">
      <div class="profile-heading">
        <div class="identity">
          <h1 id="profile-name">{site.name}</h1>
          <p class="role">PhD Student · RL, Agents, Multilinguality</p>
          <div class="affiliations">
            <a href="https://www.lighton.ai/" target="_blank" rel="noopener noreferrer" class="affiliation" aria-label="LightOn">
              <img class="lighton-mark lighton-mark-light" src="/images/LightOn-wordmark.svg" alt="" width="56" height="20" />
              <img class="lighton-mark lighton-mark-dark" src="/images/LightOn-wordmark-dark.svg" alt="" width="56" height="20" />
            </a>
            <span class="affiliation-divider" aria-hidden="true">&</span>
            <a href="https://www.inria.fr/en" target="_blank" rel="noopener noreferrer" class="affiliation">
              <img class="inria-mark" src="/images/INRIA.svg" alt="" width="56" height="20" />
              <span class="sr-only">Inria</span>
            </a>
          </div>
        </div>
        <img
          class="avatar"
          src="/images/pp_max.jpg"
          alt="Maxence Lasbordes"
          loading="eager"
          fetchpriority="high"
          width="128"
          height="128"
        />
      </div>
      {site.socialLinks && (
        <nav class="social-links" aria-label="Elsewhere">
          {site.socialLinks.map(({ platform, url }) => (
            <a href={url} target="_blank" rel="noopener noreferrer" class="social-link">
              <span class="social-icon-box" aria-hidden="true">
                <SocialIcon platform={platform} size={platform.toLowerCase() === "hugging face" ? 17 : 15} />
              </span>
              <span>{platform}</span>
            </a>
          ))}
        </nav>
      )}
    </section>

    <section class="activity" aria-label="Recent activity">
      <ol class="timeline" role="list">
        {activity.map((item) => (
          <li class="timeline-item">
            <time datetime={item.datetime}>{item.month}</time>
            <article id={item.id} class="activity-entry" aria-labelledby={`${item.id}-heading`}>
              <p class="category">{item.category}</p>
              <h2 id={`${item.id}-heading`}>{item.title}</h2>
              <p class="entry-description">{item.description}</p>
              <nav class="entry-links" aria-label={`Resources for ${item.title}`}>
                {item.links.map((link) => (
                  <a href={link.url} target={link.url.startsWith("https://") ? "_blank" : undefined} rel={link.url.startsWith("https://") ? "noopener noreferrer" : undefined}>
                    {link.label}<span aria-hidden="true"> {link.url.startsWith("https://") ? "↗" : "→"}</span>
                  </a>
                ))}
              </nav>
              {item.photos && <ActivityGallery id={item.id} photos={item.photos} rowAspectRatio={photoRowAspectRatio} />}
            </article>
          </li>
        ))}
      </ol>
    </section>
  </Container>
</BaseLayout>

<style>
  .profile {
    padding: 0.75rem 0 2.75rem;
  }

  .profile-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 112px;
    align-items: center;
    gap: 2rem;
  }

  h1 {
    margin: 0;
    font-size: 2rem;
    text-wrap: pretty;
  }

  .role {
    margin: 0.5rem 0 0.45rem;
    color: var(--text-muted);
    font-size: var(--text-lg);
  }

  .affiliations {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.625rem;
  }

  .affiliation {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-color);
    font-size: var(--text-base);
  }

  .affiliation::after {
    display: none;
  }

  .affiliation:hover {
    color: var(--link-color);
  }

  .affiliation img {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }

  .affiliation .inria-mark,
  .affiliation .lighton-mark {
    width: 56px;
    height: 20px;
    border-radius: 0;
  }

  .affiliation .inria-mark {
    transform: translateY(-3px);
  }

  .lighton-mark-dark {
    display: none;
  }

  :global([data-theme="dark"]) .lighton-mark-light {
    display: none;
  }

  :global([data-theme="dark"]) .lighton-mark-dark {
    display: block;
  }

  .affiliation-divider {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .avatar {
    width: 112px;
    height: 112px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border-color);
  }

  .social-links {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--text-muted);
    font-size: var(--text-sm);
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--border-color);
    border-radius: 0.375rem;
    white-space: nowrap;
    transition: color var(--transition-base), border-color var(--transition-base), background-color var(--transition-base);
  }

  .social-icon-box {
    display: grid;
    place-items: center;
    flex: 0 0 17px;
    width: 17px;
    height: 17px;
  }

  .social-link:hover {
    color: var(--link-color);
    border-color: var(--border-color-strong);
    background: var(--hover-bg);
  }

  .activity {
    border-top: 1px solid var(--border-color);
    padding-top: 1.75rem;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 86px minmax(0, 1fr);
    gap: 1rem;
    margin: 0;
  }

  time {
    padding-top: 0.1rem;
    color: var(--text-muted);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .activity-entry {
    position: relative;
    min-width: 0;
    border-left: 1px solid var(--border-color);
    padding: 0 0 2.5rem 1.5rem;
  }

  .activity-entry::before {
    content: "";
    position: absolute;
    width: 7px;
    height: 7px;
    left: -4px;
    top: 0.4rem;
    border-radius: 50%;
    background: var(--text-muted);
    box-shadow: 0 0 0 4px var(--bg-color);
  }

  .timeline-item:first-child .activity-entry::before {
    background: var(--link-color);
  }

  .timeline-item:last-child .activity-entry {
    padding-bottom: 0;
    border-left-color: transparent;
  }

  .category {
    margin: 0 0 0.375rem;
    color: var(--text-muted);
    font-size: var(--text-xs);
    line-height: 1.6;
  }

  .activity-entry h2 {
    margin: 0 0 0.625rem;
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.4;
    text-wrap: pretty;
  }

  .entry-description {
    margin: 0 0 0.625rem;
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.7;
  }

  .entry-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1rem;
  }

  .entry-links a {
    max-width: 100%;
    font-size: var(--text-sm);
    text-wrap: pretty;
  }

  .entry-links a span {
    font-size: var(--text-xs);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .profile {
      padding: 0.5rem 0 2.25rem;
    }

    .profile-heading {
      grid-template-columns: minmax(0, 1fr) 80px;
      gap: 1rem;
    }

    h1 {
      font-size: var(--text-2xl);
    }

    .avatar {
      width: 80px;
      height: 80px;
    }

    .role {
      font-size: var(--text-base);
    }

    .timeline-item {
      position: relative;
      grid-template-columns: minmax(0, 1fr);
      gap: 0.375rem;
      padding-left: 1.25rem;
      border-left: 1px solid var(--border-color);
      margin-left: 3px;
    }

    .timeline-item::before {
      content: "";
      position: absolute;
      left: -4px;
      top: 0.4rem;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--text-muted);
      box-shadow: 0 0 0 4px var(--bg-color);
    }

    .timeline-item:first-child::before {
      background: var(--link-color);
    }

    .timeline-item:last-child {
      border-left-color: transparent;
    }

    .activity-entry {
      padding: 0 0 2rem;
      border: 0;
    }

    .activity-entry::before {
      display: none;
    }

    .category {
      margin-bottom: 0.25rem;
    }
  }
</style>
