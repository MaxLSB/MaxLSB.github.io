---
import { getEntry } from "astro:content";
import BaseLayout from "../components/layout/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import SocialIcon from "../components/SocialIcon.astro";

const siteConfig = await getEntry("site", "home");
if (!siteConfig) {
  throw new Error("Site configuration not found");
}

const site = siteConfig.data;
---

<BaseLayout
  title={site.name}
  description="Maxence Lasbordes - PhD student working on post-training for LLMs and multilinguality"
>
  <Container>
    <section class="hero">
      <img
        class="avatar"
        src="/images/pp_max.jpg"
        alt="Maxence Lasbordes"
        loading="eager"
        fetchpriority="high"
        width="200"
        height="200"
      />

      <h1>{site.name}</h1>
      <p class="tagline">PhD student</p>

      <div class="affiliations">
        <a href="https://www.lighton.ai/" target="_blank" rel="noopener noreferrer" class="affiliation">
          <img src="/images/LightOn.png" alt="" class="mark" width="36" height="36" />
          <span>@LightOn</span>
        </a>
        <a href="https://www.inria.fr/en" target="_blank" rel="noopener noreferrer" class="affiliation">
          <img src="/images/INRIA.svg" alt="" class="mark wordmark" width="86" height="25" />
          <span>@INRIA</span>
        </a>
      </div>

      {
        site.socialLinks && (
          <nav class="social-links" aria-label="Elsewhere">
            {site.socialLinks.map(({ platform, url }: { platform: string; url: string }) => (
              <a href={url} target="_blank" rel="noopener noreferrer" class="social-link">
                <SocialIcon platform={platform} size={platform.toLowerCase() === "hugging face" ? 17 : 14} />
                <span>{platform}</span>
              </a>
            ))}
          </nav>
        )
      }
    </section>
  </Container>
</BaseLayout>

<style>
  /*
   * svh (small viewport height) rather than vh: on mobile, vh is the *large*
   * viewport, so the block used to overflow behind the browser chrome — which is
   * what the old `transform: translateY(-12rem)` hacks were compensating for.
   */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    min-height: calc(100svh - 10rem);
    justify-content: center;
    padding: 2rem 0 3rem;
  }

  .avatar {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border-color);
  }

  h1 {
    margin: 0;
  }

  .tagline {
    color: var(--text-muted);
    font-size: var(--text-lg);
    margin: -0.75rem 0 0;
    max-width: 46ch;
    text-wrap: balance;
  }

  .social-links {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    flex-wrap: wrap;
    max-width: 100%;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--border-color);
    border-radius: 0.375rem;
    color: var(--text-muted);
    font-size: var(--text-sm);
    white-space: nowrap;
    transition: color var(--transition-base), border-color var(--transition-base);
  }

  .social-link:hover {
    color: var(--text-color);
    border-color: var(--border-color-strong);
  }

  /*
   * Affiliations are a tier above the social links: larger marks, full-strength
   * text, no enclosure. Boxing them made them read as more social buttons, which
   * is exactly what they are not.
   */
  .affiliations {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  .affiliation {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--text-color);
    font-size: var(--text-lg);
    transition: color var(--transition-base);
  }

  .affiliation:hover {
    color: var(--link-color);
  }

  .affiliation::after {
    display: none; /* opt out of the global prose underline */
  }

  /* Square marks are sized by their side, wide wordmarks by their height */
  .affiliation .mark {
    width: 36px;
    height: 36px;
    object-fit: contain;
  }

  .affiliation .mark.wordmark {
    width: auto;
    height: 25px;
    /*
     * The Inria mark is lowercase script with a tail swoosh, set beside all-caps
     * text whose mass sits higher; it needs a lift the geometry alone misses.
     */
    transform: translateY(-4px);
  }

  @media (max-width: 640px) {
    .hero {
      gap: 1rem;
      padding: 1rem 0 2rem;
      min-height: calc(100svh - 8rem);
    }

    .avatar {
      width: 148px;
      height: 148px;
    }

    .tagline {
      font-size: var(--text-base);
    }

    .social-link {
      padding: 0.3rem 0.5rem;
      font-size: var(--text-xs);
    }
  }

  @media (max-width: 400px) {
    .avatar {
      width: 128px;
      height: 128px;
    }

    .social-links {
      gap: 0.375rem;
    }
  }
</style>
