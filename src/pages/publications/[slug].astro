---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../components/layout/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";

export const getStaticPaths = (async () => {
  const publications = await getCollection("publications");
  return publications.map((publication) => ({
    params: { slug: publication.id },
    props: { publication },
  }));
}) satisfies GetStaticPaths;

const { publication } = Astro.props;

// Markdown body has to go through render(); `publication.body` is the raw source
const { Content } = await render(publication);

const links = [
  publication.data.url && { label: "Paper", url: publication.data.url },
  publication.data.pdf && publication.data.pdf !== publication.data.url && { label: "PDF", url: publication.data.pdf },
  publication.data.github && { label: "Code", url: publication.data.github },
  publication.data.huggingface && { label: "Models", url: publication.data.huggingface },
  ...(publication.data.additionalLinks ?? []),
].filter(Boolean) as Array<{ label: string; url: string }>;

/*
 * Abstracts are multi-paragraph YAML flow scalars. YAML folds line breaks inside
 * a paragraph into spaces and collapses a blank line to a single "\n", so a
 * single newline — not a blank line — is the paragraph separator here.
 */
const abstractParagraphs =
  publication.data.abstract
    ?.split(/\n+/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean) ?? [];
---

<BaseLayout title={publication.data.title} description={publication.data.abstract ?? publication.data.title}>
  <Container>
    <article class="publication">
      <header class="publication-header">
        <h1>{publication.data.title}</h1>
        <p class="authors">{publication.data.authors.join(", ")}</p>
        <p class="venue">{publication.data.venue} ({publication.data.year})</p>

        {
          links.length > 0 && (
            <nav class="publication-links" aria-label="Publication links">
              {links.map((link) => (
                <a href={link.url} target="_blank" rel="noopener noreferrer" class="link-button">
                  {link.label}
                </a>
              ))}
            </nav>
          )
        }
      </header>

      {
        abstractParagraphs.length > 0 && (
          <section class="abstract">
            <h2>Abstract</h2>
            {abstractParagraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </section>
        )
      }

      {
        publication.data.tags && publication.data.tags.length > 0 && (
          <ul class="tags">
            {publication.data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }

      <div class="publication-content">
        <Content />
      </div>
    </article>
  </Container>
</BaseLayout>

<style>
  .publication {
    padding: 1rem 0 2rem;
  }

  .publication-header {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .publication-header h1 {
    font-size: var(--text-2xl);
    margin-bottom: 0.75rem;
  }

  .authors {
    color: var(--text-color);
    margin-bottom: 0.125rem;
  }

  /* Was var(--muted-text-color) — a token that does not exist, so this had no colour */
  .venue {
    color: var(--text-muted);
    font-size: var(--text-sm);
    margin-bottom: 0;
  }

  .publication-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .link-button {
    padding: 0.35rem 0.85rem;
    font-size: var(--text-sm);
    color: var(--text-color);
    border: 1px solid var(--border-color-strong);
    border-radius: 0.375rem;
    transition: color var(--transition-base), border-color var(--transition-base);
  }

  .link-button:hover {
    color: var(--link-color);
    border-color: var(--link-color);
  }

  .link-button::after {
    display: none; /* opt out of the global prose underline */
  }

  .abstract {
    margin-top: 2rem;
  }

  .abstract h2 {
    font-size: var(--text-sm);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .abstract p {
    max-width: 70ch;
    margin-bottom: 0.875rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .tags li {
    font-size: var(--text-xs);
    color: var(--text-muted);
    /* Was var(--bg-secondary) — undefined, so these chips rendered flat */
    background-color: var(--bg-color-muted);
    border: 1px solid var(--border-color);
    border-radius: 0.25rem;
    padding: 0.1rem 0.45rem;
    margin: 0;
  }

  .publication-content:not(:empty) {
    margin-top: 2rem;
  }

  @media (max-width: 640px) {
    .publication-header h1 {
      font-size: var(--text-xl);
    }
  }
</style>
