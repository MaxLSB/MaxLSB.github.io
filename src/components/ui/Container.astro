---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["container", className]}>
  <slot />
</div>

<style>
  .container {
    /* Same gutter token as the nav, so page content lines up with the nav links */
    padding: 0 var(--gutter);
  }
</style>
