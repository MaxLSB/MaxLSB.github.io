---
interface Props {
  title: string;
  subtitle: string;
  dates: string;
  description?: string;
  logos: Array<{ src: string; name: string }>;
}

const { title, subtitle, dates, description, logos } = Astro.props;
---

<article class="resume-entry">
  <div class="logos">
    {logos.map((logo) => (
      <div class="logo-tile">
        <img src={logo.src} alt={logo.name} width="48" height="48" loading="lazy" />
      </div>
    ))}
  </div>
  <div class="details">
    <h3>{title}</h3>
    <p class="subtitle-line">{subtitle}</p>
    <p class="dates">{dates}</p>
    {description && <p class="description">{description}</p>}
  </div>
</article>

<style>
  .resume-entry {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    align-items: start;
    gap: 1.25rem;
  }

  .logos {
    display: flex;
    flex-direction: row;
    gap: 0.375rem;
    width: max-content;
    min-width: 56px;
  }

  .details {
    min-width: 0;
  }

  .logo-tile {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    padding: 4px;
    border: 1px solid var(--border-color);
    border-radius: 0.375rem;
    /* Keep the original brand colours legible in either page theme. */
    background: #fff;
  }

  .logo-tile img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 0;
  }

  h3 {
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.4;
    margin: 0 0 0.2rem;
    text-wrap: pretty;
  }

  p {
    margin: 0;
    line-height: 1.6;
  }

  .subtitle-line {
    font-size: var(--text-base);
  }

  .dates {
    margin-top: 0.15rem;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .description {
    margin-top: 0.625rem;
    color: var(--text-muted);
    font-size: var(--text-sm);
    max-width: 60ch;
  }

  @media (max-width: 640px) {
    .resume-entry {
      gap: 0.875rem;
    }

    .logos {
      min-width: 48px;
    }

    .logo-tile {
      width: 48px;
      height: 48px;
    }

    h3 {
      font-size: var(--text-base);
    }

    .subtitle-line {
      font-size: var(--text-sm);
    }
  }
</style>
