---
// Icon swap is driven entirely by [data-theme] on <html>, which the inline
// head script sets before first paint — so the button never renders "wrong".
---

<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch between light and dark theme">
  <svg
    class="sun-icon"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4.5"></circle>
    <path
      d="M12 1.5v2.2M12 20.3v2.2M4.22 4.22l1.56 1.56M18.22 18.22l1.56 1.56M1.5 12h2.2M20.3 12h2.2M4.22 19.78l1.56-1.56M18.22 5.78l1.56-1.56"
    ></path>
  </svg>
  <svg
    class="moon-icon"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    flex-shrink: 0;
    background: none;
    border: none;
    border-radius: 0.375rem;
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--transition-base), background-color var(--transition-base);
  }

  .theme-toggle:hover {
    color: var(--text-color);
    background-color: var(--hover-bg);
  }

  .theme-toggle svg {
    grid-area: 1 / 1;
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  .moon-icon,
  :global([data-theme="dark"]) .sun-icon {
    opacity: 0;
    transform: scale(0.7) rotate(-30deg);
  }

  .sun-icon,
  :global([data-theme="dark"]) .moon-icon {
    opacity: 1;
    transform: none;
  }

  /* The 44px mobile touch minimum applies to buttons; keep the icon box square */
  @media (max-width: 640px) {
    .theme-toggle {
      width: 44px;
      height: 44px;
    }
  }
</style>

<script>
  function initThemeToggle() {
    const toggle = document.getElementById("theme-toggle");
    if (!toggle || toggle.dataset.bound === "true") return;
    toggle.dataset.bound = "true";

    toggle.addEventListener("click", () => {
      const root = document.documentElement;
      const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      localStorage.setItem("theme", next);
    });
  }

  initThemeToggle();
  document.addEventListener("astro:page-load", initThemeToggle);
</script>
