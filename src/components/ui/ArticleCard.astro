---
interface Props {
  title: string;
  description?: string;
  url: string;
  date?: Date;
  dateRange?: string;
  /** Short emphasised label shown in the metadata column (e.g. a publication venue) */
  badge?: string;
  tags?: string[];
  additionalLinks?: Array<{ label: string; url: string; platform?: string }>;
  logo?: string;
  clickable?: boolean;
  noBorder?: boolean;
}

const {
  title,
  description,
  url,
  date,
  dateRange,
  badge,
  tags,
  additionalLinks,
  logo,
  clickable = true,
  noBorder = false,
} = Astro.props;
import { formatDate } from "../../utils/date";
import SocialIcon from "../SocialIcon.astro";
---

<article class:list={["project-card", { clickable, "no-border": noBorder, "has-logo": !!logo }]}>
  <div class="card-content">
    {
      logo && (
        <div class="logo-container">
          <img src={logo} alt="" class="logo" width="48" height="48" loading="lazy" />
        </div>
      )
    }
    <div class="content">
      <div class="title-row">
        {
          clickable ? (
            <a href={url} target="_blank" rel="noopener noreferrer">
              {title}
            </a>
          ) : (
            <span class="title-text">{title}</span>
          )
        }
        <div class="title-right">
          {badge && <span class="badge">{badge}</span>}
          {dateRange && <span class="date-range">{dateRange}</span>}
          {date && !dateRange && <time datetime={date.toISOString()}>{formatDate(date)}</time>}
          {
            additionalLinks && additionalLinks.length > 0 && (
              <div class="logo-group">
                {additionalLinks.map((link) => (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class:list={[
                      "logo-link",
                      { "text-link": !link.platform },
                    ]}
                    aria-label={`${link.label} — ${title}`}
                  >
                    {/*
                      Fall back to the label when there is no platform icon: an
                      icon-only link with an unknown platform used to render an
                      empty, invisible box.
                    */}
                    {link.platform ? <SocialIcon platform={link.platform} size={22} /> : link.label}
                  </a>
                ))}
              </div>
            )
          }
        </div>
      </div>
      {description && <p class="muted-text">{description}</p>}
      {
        tags && tags.length > 0 && (
          <ul class="tags">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</article>

<style>
  .project-card {
    border: 1px solid var(--border-color);
    border-radius: 0.5rem;
    padding: 0.875rem;
    transition: background-color var(--transition-base), border-color var(--transition-base);
  }

  .project-card:not(.no-border) {
    background-color: var(--surface-color);
  }

  .project-card.clickable:hover {
    border-color: var(--border-color-strong);
  }

  /*
   * Borderless list rows get a hairline separator instead — without it the rows
   * on /publications, /projects and /blog ran together with nothing between them.
   */
  .project-card.no-border {
    border: none;
    border-bottom: 1px solid var(--border-color);
    border-radius: 0;
    padding: 0 0 1rem;
  }

  .project-card.no-border:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .card-content {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* Only reserve logo-sized height when there actually is a logo */
  .project-card.has-logo .card-content {
    min-height: 60px;
  }

  .logo-container {
    flex-shrink: 0;
  }

  .logo {
    width: 48px;
    height: 48px;
    object-fit: contain;
    border-radius: 0.375rem;
  }

  .content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .title-row a,
  .title-text {
    font-size: var(--text-lg);
    color: var(--text-color);
    line-height: 1.35;
    text-wrap: pretty;
  }

  .title-row a:hover {
    color: var(--link-color);
  }

  .title-right {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    flex-shrink: 0;
  }

  .logo-group {
    display: flex;
    gap: 0.125rem;
    align-items: center;
  }

  .logo-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    color: var(--text-muted);
    transition: color var(--transition-base);
  }

  .logo-link:hover {
    color: var(--text-color);
  }

  .logo-link.text-link {
    width: auto;
    padding: 0 0.375rem;
    font-size: var(--text-xs);
    border: 1px solid var(--border-color);
    border-radius: 0.25rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
  }

  .tags li {
    color: var(--text-muted);
    font-size: var(--text-xs);
    margin: 0;
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--border-color);
    border-radius: 0.25rem;
  }

  .muted-text {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    max-width: none;
  }

  /*
   * Reads as emphasis rather than metadata: full-strength text colour and a
   * border, against the muted authors line underneath.
   */
  .badge {
    color: var(--text-color);
    font-size: var(--text-xs);
    white-space: nowrap;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--border-color-strong);
    border-radius: 0.25rem;
  }

  .date-range,
  time {
    color: var(--text-muted);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .project-card {
      padding: 0.75rem;
    }

    .card-content {
      gap: 0.75rem;
    }

    .project-card.has-logo .card-content {
      min-height: 52px;
    }

    .logo {
      width: 40px;
      height: 40px;
    }

    /* Stack title above its metadata, and keep the metadata on one row */
    .title-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.375rem;
    }

    .title-right {
      align-self: stretch;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .logo {
      width: 36px;
      height: 36px;
    }

    .title-row a,
    .title-text {
      font-size: var(--text-base);
    }

    .logo-link {
      width: 26px;
      height: 26px;
    }
  }
</style>
