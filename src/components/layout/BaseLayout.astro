---
import "../../styles/theme.css";
import "../../styles/animations.css";
import "../../styles/global.css";

import "@fontsource/inter/300.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/roboto-mono/400.css";

import interLightWoff2 from "@fontsource/inter/files/inter-latin-300-normal.woff2?url";
import interRegularWoff2 from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import interMediumWoff2 from "@fontsource/inter/files/inter-latin-500-normal.woff2?url";
import { ClientRouter } from "astro:transitions";
import Navigation from "../shared/Navigation.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: string;
}

const { title, description, image = "/images/pp_max.jpg", canonicalURL = Astro.url } = Astro.props;

// Crawlers need absolute URLs for social images
const ogImage = new URL(image, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!--
      Theme is resolved before first paint. This has to be `is:inline` (and stay
      in <head>): a bundled Astro script is deferred, which made every load flash
      the light theme before switching to dark.
    -->
    <script is:inline>
      (() => {
        // Light is the default: the OS "prefers dark" setting is deliberately not
        // consulted. Only an explicit choice made with the toggle is honoured.
        const stored = localStorage.getItem("theme");
        const theme = stored === "light" || stored === "dark" ? stored : "light";
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>

    <link rel="preload" href={interLightWoff2} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={interRegularWoff2} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={interMediumWoff2} as="font" type="font/woff2" crossorigin="anonymous" />

    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
  </head>
  <body>
    <div class="page-glow" aria-hidden="true" transition:persist></div>
    <div class="page">
      <header class="nav-container">
        <Navigation />
      </header>
      <main><slot /></main>
    </div>

    <script>
      // Enable colour transitions only after first paint, so switching themes
      // animates but loading a page never does.
      const enableTransitions = () => {
        requestAnimationFrame(() => document.documentElement.classList.add("theme-transition"));
      };

      enableTransitions();
      document.addEventListener("astro:after-swap", enableTransitions);

      // Keep the chosen theme across view transitions
      document.addEventListener("astro:before-swap", (event) => {
        const theme = document.documentElement.getAttribute("data-theme");
        const incoming = (event as unknown as { newDocument?: Document }).newDocument;
        if (theme && incoming) {
          incoming.documentElement.setAttribute("data-theme", theme);
        }
      });
    </script>
  </body>
</html>
