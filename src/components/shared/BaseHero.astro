---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="hero">
  <h1>{title}</h1>
</header>

<style>
  /*
   * Left-aligned: everything below the header (cards, prose) is left-aligned, so
   * a centred title read as a different page.
   */
  .hero {
    padding: 1rem 0 2rem;
  }

  .hero h1 {
    margin-bottom: 0;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 0.5rem 0 1.5rem;
    }

    .hero h1 {
      font-size: var(--text-2xl);
    }

  }
</style>
