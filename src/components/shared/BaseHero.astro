---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<header class="hero">
  <h1>{title}</h1>
  <p class="subtitle">{description}</p>
</header>

<style>
  /*
   * Left-aligned: everything below the header (cards, prose) is left-aligned, so
   * a centred title read as a different page.
   */
  .hero {
    padding: 1rem 0 2rem;
  }

  .hero h1 {
    margin-bottom: 0.25rem;
  }

  .subtitle {
    color: var(--text-muted);
    font-size: var(--text-lg);
    margin: 0;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 0.5rem 0 1.5rem;
    }

    .hero h1 {
      font-size: var(--text-2xl);
    }

    .subtitle {
      font-size: var(--text-base);
    }
  }
</style>
