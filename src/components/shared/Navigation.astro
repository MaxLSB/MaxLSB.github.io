---
import { NAVIGATION } from "../../constants/navigation";
import ThemeToggle from "../ui/ThemeToggle.astro";

const pathname = new URL(Astro.request.url).pathname;

const isActive = (path: string) => {
  if (path === "/") return pathname === "/";
  return pathname.startsWith(path);
};
---

<nav aria-label="Main">
  <ul class="nav-links">
    {
      NAVIGATION.map(({ name, path }) => (
        <li>
          <a href={path} class={isActive(path) ? "active" : ""} aria-current={isActive(path) ? "page" : undefined}>
            {name}
          </a>
        </li>
      ))
    }
  </ul>
  <ThemeToggle />
</nav>

<style>
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  .nav-links li {
    margin: 0;
    list-style: none;
  }

  .nav-links a {
    color: var(--text-muted);
    font-size: var(--text-sm);
    white-space: nowrap;
    transition: color var(--transition-base);
  }

  .nav-links a:hover {
    color: var(--text-color);
  }

  .nav-links a.active {
    color: var(--text-color);
  }

  /* Persistent underline for the current page; the global hover rule handles the rest */
  .nav-links a.active::after {
    width: 100%;
    background: var(--border-color-strong);
  }

  /*
   * Stays a single row down to the smallest widths: the links wrap instead, and
   * the theme toggle keeps its place on the right.
   */
  @media (max-width: 640px) {
    .nav-links {
      gap: 0.25rem 0.9rem;
    }

    .nav-links a {
      font-size: var(--text-xs);
    }
  }

  @media (max-width: 400px) {
    .nav-links {
      gap: 0.25rem 0.7rem;
    }
  }
</style>
